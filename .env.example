# MotorStorm Discord Bots - Environment Variables Template
# Copy this file to .env and fill in your values

# ===========================================
# BOT TOKENS (Required - get from Discord Developer Portal)
# ===========================================
DISCORD_TOKEN_AE=           # Token for MotorStorm Arctic Edge bot
DISCORD_TOKEN_APOC=         # Token for MotorStorm Apocalypse bot
DISCORD_TOKEN_PR=           # Token for MotorStorm Pacific Rift bot
DISCORD_TOKEN_MV=           # Token for MotorStorm Monument Valley bot
DISCORD_TOKEN_HELPER=       # Token for Helper/Analytics bot

# ===========================================
# CHANNEL IDS (Required - comma-separated)
# ===========================================
CHANNEL_IDS_AE=             # Discord channel IDs for AE status updates (e.g., "123456789,123456790")
CHANNEL_IDS_APOC=          # Discord channel IDs for Apoc status updates
CHANNEL_IDS_PR=            # Discord channel IDs for PR status updates
CHANNEL_IDS_MV=            # Discord channel IDs for MV status updates

# ===========================================
# NOTIFICATION SETTINGS (Optional)
# ===========================================
NOTIFICATION_CHANNEL_AE=    # Channel ID for AE lobby notifications
NOTIFICATION_CHANNEL_APOC= # Channel ID for Apoc lobby notifications
NOTIFICATION_CHANNEL_PR=   # Channel ID for PR lobby notifications
NOTIFICATION_CHANNEL_MV=   # Channel ID for MV lobby notifications

NOTIFICATION_ROLE_AE=      # Role ID to mention in AE notifications
NOTIFICATION_ROLE_APOC=    # Role ID to mention in Apoc notifications
NOTIFICATION_ROLE_PR=      # Role ID to mention in PR notifications
NOTIFICATION_ROLE_MV=      # Role ID to mention in MV notifications

NOTIFICATION_PINGS_AE=     # Enable @mentions: "true" or "false" (default: false)
NOTIFICATION_PINGS_APOC=   # Enable @mentions: "true" or "false" (default: false)
NOTIFICATION_PINGS_PR=     # Enable @mentions: "true" or "false" (default: false)
NOTIFICATION_PINGS_MV=     # Enable @mentions: "true" or "false" (default: false)

# ===========================================
# DATABASE CONFIGURATION (Required for analytics)
# ===========================================
MYSQL_HOST=localhost        # Database host
MYSQL_PORT=3306            # Database port
MYSQL_USER=root            # Database username
MYSQL_PASSWORD=            # Database password
MYSQL_DATABASE=motorstorm_stats  # Database name

# ===========================================
# COMMAND DEPLOYMENT (Optional - for slash commands)
# ===========================================
DISCORD_CLIENT_ID=         # Your Discord Application Client ID
DISCORD_GUILD_ID=          # Server ID for development (faster command updates)

# ===========================================
# DEBUGGING
# ===========================================
DEBUG=false                # Enable debug logging: "true" or "false"