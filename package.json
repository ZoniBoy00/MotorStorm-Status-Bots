{
  "name": "motorstorm-status-bots",
  "version": "2.2.1",
  "description": "Production-ready TypeScript Discord bots for MotorStorm server monitoring, lobby notifications, and analytics",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "start": "npm run build && node dist/index.js",
    "start:dev": "ts-node src/index.ts",
    "start:ae": "ts-node src/bots/motorstorm-ae/index.ts",
    "start:apoc": "ts-node src/bots/motorstorm-apoc/index.ts",
    "start:pr": "ts-node src/bots/motorstorm-pr/index.ts",
    "start:mv": "ts-node src/bots/motorstorm-mv/index.ts",
    "migrate": "ts-node src/scripts/migrate-to-mysql.ts",
    "deploy": "ts-node src/scripts/deploy-commands.ts",
    "clean": "rm -rf dist",
    "watch": "tsc --watch"
  },
  "keywords": [
    "discord",
    "bot",
    "motorstorm",
    "typescript",
    "gaming",
    "notifications",
    "lobby-alerts"
  ],
  "author": "ZoniBoy00",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.19.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "mysql2": "^3.23.3",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/xml2js": "^0.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
